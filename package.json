{
  "name": "ts-utilkit",
  "version": "0.1.0",
  "description": "A collection of reusable TypeScript utility functions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MForofontov/ts-utilkit.git"
  },
  "keywords": [
    "typescript",
    "utilities",
    "functions",
    "helpers",
    "toolkit",
    "utils",
    "type-safe",
    "enterprise"
  ],
  "author": "Mykyta Forofontov",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest --config jest.local.config.ts --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "test:github": "./run-tests-github.sh",
    "test:local": "jest --config jest.local.config.ts",
    "test:install:full": "node scripts/test-install.cjs",
    "test:array": "npm test -w @ts-utilkit/array",
    "test:async": "npm test -w @ts-utilkit/async",
    "test:collection": "npm test -w @ts-utilkit/collection",
    "test:crypto": "npm test -w @ts-utilkit/crypto",
    "test:date": "npm test -w @ts-utilkit/date",
    "test:encoding": "npm test -w @ts-utilkit/encoding",
    "test:env": "npm test -w @ts-utilkit/env",
    "test:event": "npm test -w @ts-utilkit/event",
    "test:format": "npm test -w @ts-utilkit/format",
    "test:math": "npm test -w @ts-utilkit/math",
    "test:network": "npm test -w @ts-utilkit/network",
    "test:object": "npm test -w @ts-utilkit/object",
    "test:parsing": "npm test -w @ts-utilkit/parsing",
    "test:path": "npm test -w @ts-utilkit/path",
    "test:random": "npm test -w @ts-utilkit/random",
    "test:regex": "npm test -w @ts-utilkit/regex",
    "test:result": "npm test -w @ts-utilkit/result",
    "test:serialization": "npm test -w @ts-utilkit/serialization",
    "test:string": "npm test -w @ts-utilkit/string",
    "test:testing-utilities": "npm test -w @ts-utilkit/testing-utilities",
    "test:utility": "npm test -w @ts-utilkit/utility",
    "test:validation": "npm test -w @ts-utilkit/validation",
    "test:webscraping": "npm test -w @ts-utilkit/webscraping",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "audit:exports": "node scripts/audit-exports.cjs",
    "audit:docs": "node scripts/audit-docs.cjs",
    "benchmark:existing": "node scripts/benchmark-existing.cjs",
    "benchmark:array-membership": "node scripts/benchmark-array-membership.cjs",
    "benchmark:substring": "node scripts/benchmark-substring.cjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.3.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.5.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "jest-util": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "jest-allure": "^0.1.3"
  }
}
